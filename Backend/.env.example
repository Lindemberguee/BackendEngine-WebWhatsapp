NODE_ENV=production
PORT=3310
HOST=0.0.0.0

# ── MongoDB ──────────────────────────────────────────────
# Sob Docker o MONGODB_URI é montado pelo compose a partir destes 4 valores.
MONGODB_URI=
# ── Segredos da aplicação (todos diferentes entre si) ────
JWT_SECRET=0e432038d9febef7c1a13ebad521339c
JWT_EXPIRES_IN=7d
CREDENTIALS_ENCRYPTION_KEY=0e432038d9febef7c1a13ebad521339c
PLATFORM_ADMIN_API_KEY=0e432038d9febef7c1a13ebad521339c

# ── Rede ─────────────────────────────────────────────────
CORS_ORIGIN=http://127.0.0.1:3000
PUBLIC_API_URL=http://127.0.0.1:3333

LOG_LEVEL=info
SENTRY_DSN=

# ── WhatsApp via QR (Baileys) — META_* não é necessário ──
META_GRAPH_VERSION=v25.0

# ── Mídia em Cloudflare R2 ───────────────────────────────
MEDIA_STORAGE_DRIVER=s3
MEDIA_S3_REGION=auto
MEDIA_R2_ACCOUNT_ID=
MEDIA_S3_BUCKET=webwhatsapp
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_FORCE_PATH_STYLE=false

