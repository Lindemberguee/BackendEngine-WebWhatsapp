# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3333
HOST=0.0.0.0

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/webwhatsapp
# Atlas example: mongodb+srv://user:pass@cluster.mongodb.net/webwhatsapp

# Used by docker-compose to initialize the private MongoDB container and build
# the backend connection URI. Prefer random hexadecimal values so the password
# does not require URL encoding inside MONGODB_URI.
MONGO_ROOT_USERNAME=webwhatsapp_admin
MONGO_ROOT_PASSWORD=replace-with-a-long-random-hex-password
MONGO_APP_USERNAME=webwhatsapp_app
MONGO_APP_PASSWORD=replace-with-another-long-random-hex-password

# Development-only access to the optional mongo-express profile. The UI binds
# to 127.0.0.1 and is not exposed publicly by default.
MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=replace-with-a-random-development-password

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-random-256-bit-secret
JWT_EXPIRES_IN=7d

# AES-256 key used to encrypt Meta access tokens and app secrets at rest.
# Generate independently from JWT_SECRET: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIALS_ENCRYPTION_KEY=replace-with-an-independent-64-character-hex-key

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ─── Public URL ───────────────────────────────────────────────────────────────
# This server's own publicly-reachable origin — used to build absolute URLs (e.g.
# user avatars) that get embedded in API responses and loaded directly by <img> tags.
PUBLIC_API_URL=http://localhost:3333

# ─── Logs ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─── Error tracking ───────────────────────────────────────────────────────────
# Leave unset locally — no DSN means Sentry is a complete no-op (see server.ts).
SENTRY_DSN=

# Internal key used only by the frontend server to access the platform backoffice.
# Generate a long random value and configure the same value in the frontend.
PLATFORM_ADMIN_API_KEY=replace-with-at-least-32-random-characters

# Meta WhatsApp Cloud API. Credentials for each customer/WABA are encrypted in
# MongoDB; these values identify the platform's shared Meta app.
META_GRAPH_VERSION=v25.0
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=replace-with-a-long-random-token
META_EMBEDDED_SIGNUP_CONFIG_ID=

# Persistent media storage. Keep "local" for development; use "s3" in production
# with Cloudflare R2. The bucket can remain private because media is served by the API.
MEDIA_STORAGE_DRIVER=local
MEDIA_LOCAL_DIR=./data/media
# Cloudflare account ID. When set, MEDIA_S3_ENDPOINT is derived automatically as
# https://<ACCOUNT_ID>.r2.cloudflarestorage.com
MEDIA_R2_ACCOUNT_ID=
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=auto
# Optional override for another S3-compatible provider.
MEDIA_S3_ENDPOINT=
# Create these credentials from an R2 API token with Object Read & Write access.
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_FORCE_PATH_STYLE=false
